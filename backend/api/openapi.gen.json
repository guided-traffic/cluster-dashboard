{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "examples": {
              "notFound": {
                "summary": "No such route",
                "value": {
                  "code": "not_found",
                  "detail": "no route GET /api/v1/nothing",
                  "instance": "/api/v1/nothing",
                  "request_id": "019a2b3c-4d5e-7f60-8a9b-0c1d2e3f4a5b",
                  "status": 404,
                  "title": "Not found",
                  "type": "https://dash.gtrfc.com/problems/not-found"
                }
              },
              "validationFailed": {
                "summary": "A query parameter the document does not know; errors[] names it",
                "value": {
                  "code": "validation_failed",
                  "detail": "the request has parameters this route does not know",
                  "errors": [
                    {
                      "message": "unknown parameter",
                      "pointer": "query:verbose"
                    }
                  ],
                  "instance": "/api/v1/version",
                  "request_id": "019a2b3c-4d5e-7f60-8a9b-0c1d2e3f4a5c",
                  "status": 400,
                  "title": "Validation failed",
                  "type": "https://dash.gtrfc.com/problems/validation-failed"
                }
              }
            },
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "An RFC 9457 problem details body with a stable `code`, the `request_id` and, for a request the\ndocument refuses, `errors[]`.\n",
        "headers": {
          "X-Request-Id": {
            "description": "The request's id, also in the body and in the log line",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "schemas": {
      "App": {
        "description": "A tile",
        "properties": {
          "id": {
            "description": "Unique on the page: ingress/\u003cnamespace\u003e/\u003cname\u003e or app/\u003cgroup\u003e/\u003cindex\u003e",
            "type": "string"
          },
          "info": {
            "description": "The description; absent while ui.showAppInfo is off or the app has none",
            "type": "string"
          },
          "kind": {
            "description": "ingress: discovered; app: configured under apps",
            "enum": [
              "ingress",
              "app"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AppStatus"
          },
          "target_blank": {
            "type": "boolean"
          },
          "url": {
            "description": "An absolute http or https URL",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "url",
          "target_blank",
          "status"
        ],
        "type": "object"
      },
      "AppGroup": {
        "properties": {
          "apps": {
            "description": "Ordered by name",
            "items": {
              "$ref": "#/components/schemas/App"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "apps"
        ],
        "type": "object"
      },
      "AppStatus": {
        "description": "The readiness: endpoints ready over all, each pod once; unknown for a configured app and while ui.showAppStatus is off",
        "properties": {
          "ready": {
            "minimum": 0,
            "type": "integer"
          },
          "state": {
            "enum": [
              "healthy",
              "degraded",
              "down",
              "unknown"
            ],
            "type": "string"
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "state",
          "ready",
          "total"
        ],
        "type": "object"
      },
      "Bookmark": {
        "properties": {
          "id": {
            "description": "bookmark/\u003cgroup\u003e/\u003cindex\u003e",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "target_blank": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "target_blank"
        ],
        "type": "object"
      },
      "BookmarkGroup": {
        "properties": {
          "bookmarks": {
            "items": {
              "$ref": "#/components/schemas/Bookmark"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "bookmarks"
        ],
        "type": "object"
      },
      "Dashboard": {
        "description": "The page's content (backend/internal/dashboard)",
        "example": {
          "bookmarks": [
            {
              "bookmarks": [
                {
                  "id": "bookmark/0/0",
                  "name": "Kubernetes",
                  "target_blank": true,
                  "url": "https://kubernetes.io/docs"
                }
              ],
              "name": "docs"
            }
          ],
          "discovery": {
            "enabled": true,
            "instance_name": "",
            "namespaces": {
              "any": true,
              "label_selector": "",
              "names": []
            }
          },
          "groups": [
            {
              "apps": [
                {
                  "id": "ingress/monitoring/grafana",
                  "kind": "ingress",
                  "name": "Grafana",
                  "status": {
                    "ready": 2,
                    "state": "healthy",
                    "total": 2
                  },
                  "target_blank": false,
                  "url": "https://grafana.example.com/"
                },
                {
                  "id": "ingress/monitoring/prometheus",
                  "kind": "ingress",
                  "name": "Prometheus",
                  "status": {
                    "ready": 1,
                    "state": "degraded",
                    "total": 2
                  },
                  "target_blank": false,
                  "url": "https://prometheus.example.com/"
                }
              ],
              "name": "monitoring"
            }
          ],
          "summary": {
            "degraded": 1,
            "down": 0,
            "healthy": 1,
            "total": 2,
            "unknown": 0
          },
          "ui": {
            "default_theme": "system",
            "greeting": {
              "enabled": true,
              "name": "You"
            },
            "refresh_seconds": 60,
            "show_app_groups": true,
            "show_app_urls": true,
            "show_bookmark_groups": true,
            "show_summary": true,
            "title": "Dash"
          }
        },
        "properties": {
          "bookmarks": {
            "description": "The bookmark groups in the configuration's order. Empty while ui.showBookmarks is off",
            "items": {
              "$ref": "#/components/schemas/BookmarkGroup"
            },
            "type": "array"
          },
          "discovery": {
            "$ref": "#/components/schemas/DiscoveryScope"
          },
          "groups": {
            "description": "The app groups: those ui.groupOrder names first, in its order, then by name. Empty while ui.showApps is off",
            "items": {
              "$ref": "#/components/schemas/AppGroup"
            },
            "type": "array"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          },
          "ui": {
            "$ref": "#/components/schemas/DashboardUI"
          }
        },
        "required": [
          "ui",
          "discovery",
          "summary",
          "groups",
          "bookmarks"
        ],
        "type": "object"
      },
      "DashboardUI": {
        "description": "The ui settings the page applies itself",
        "properties": {
          "default_theme": {
            "description": "The colour scheme until a person picks one",
            "enum": [
              "system",
              "light",
              "dark"
            ],
            "type": "string"
          },
          "greeting": {
            "$ref": "#/components/schemas/Greeting"
          },
          "refresh_seconds": {
            "maximum": 3600,
            "minimum": 5,
            "type": "integer"
          },
          "show_app_groups": {
            "type": "boolean"
          },
          "show_app_urls": {
            "type": "boolean"
          },
          "show_bookmark_groups": {
            "type": "boolean"
          },
          "show_summary": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "greeting",
          "default_theme",
          "refresh_seconds",
          "show_summary",
          "show_app_groups",
          "show_app_urls",
          "show_bookmark_groups"
        ],
        "type": "object"
      },
      "DiscoveryScope": {
        "description": "What the discovery reads, for the page that has no app to show",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "instance_name": {
            "description": "discovery.instanceName; empty: every instance",
            "type": "string"
          },
          "namespaces": {
            "$ref": "#/components/schemas/NamespaceScope"
          }
        },
        "required": [
          "enabled",
          "instance_name",
          "namespaces"
        ],
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "message": {
            "type": "string"
          },
          "pointer": {
            "description": "A JSON pointer into the body, or query:\u003cname\u003e for a query parameter",
            "type": "string"
          }
        },
        "required": [
          "pointer",
          "message"
        ],
        "type": "object"
      },
      "Greeting": {
        "description": "The line under the title, the time of day and a name",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "enabled",
          "name"
        ],
        "type": "object"
      },
      "NamespaceScope": {
        "description": "The namespace selector: every namespace, or the names united with the label selector's matches",
        "properties": {
          "any": {
            "type": "boolean"
          },
          "label_selector": {
            "description": "The label selector in its text form, such as dash=listed; empty: none",
            "type": "string"
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "any",
          "names",
          "label_selector"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "An RFC 9457 problem details body (backend/internal/problem)",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "detail": {
            "description": "For a person; never a secret, a stack trace or an internal address",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "description": "The request path, without its query",
            "type": "string"
          },
          "request_id": {
            "description": "The id of the request, also in X-Request-Id and in the request log",
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "The code as a URI, https://dash.gtrfc.com/problems/\u003ccode\u003e; an identifier, not a link",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "ProblemCode": {
        "description": "The stable code of a problem",
        "enum": [
          "validation_failed",
          "not_found",
          "method_not_allowed",
          "internal",
          "not_ready"
        ],
        "type": "string"
      },
      "Summary": {
        "description": "The apps served, counted by state",
        "properties": {
          "degraded": {
            "minimum": 0,
            "type": "integer"
          },
          "down": {
            "minimum": 0,
            "type": "integer"
          },
          "healthy": {
            "minimum": 0,
            "type": "integer"
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          },
          "unknown": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "total",
          "healthy",
          "degraded",
          "down",
          "unknown"
        ],
        "type": "object"
      },
      "Version": {
        "example": {
          "build_time": "1793000000",
          "commit": "6c4adc7",
          "version": "0.1.0"
        },
        "properties": {
          "build_time": {
            "description": "When it was built, in seconds since the epoch",
            "type": "string"
          },
          "commit": {
            "description": "The commit the binary was built from",
            "type": "string"
          },
          "version": {
            "description": "The release, such as 0.1.0; dev for a build outside the release pipeline",
            "type": "string"
          }
        },
        "required": [
          "version",
          "commit",
          "build_time"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The API of Dash, a start page of the apps a Kubernetes cluster serves.\n\nThere is no login: whoever reaches the dashboard's host reaches this API, and protection is\nthe Ingress controller's (docs/security/exposure.md). The browser reaches it on the same\norigin as the UI: the Ingress `\u003cfullname\u003e-backend` routes `/api/` here. Errors are RFC 9457\nproblem details with a stable `code`.\n",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "title": "Dash",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/dashboard": {
      "get": {
        "description": "The app groups — discovered through Ingresses and configured — the bookmark groups, the summary\nof the apps' states and the page's settings. Answered from the discovery's cache: a request\ncosts the Kubernetes API server nothing. The page asks on load, every `ui.refreshSeconds` and\nwhen it becomes visible again. What the configuration hides (`ui.showApps`, `ui.showBookmarks`,\n`ui.showAppInfo`, `ui.showAppStatus`) is left out of the answer, not only out of the page.\n",
        "operationId": "getDashboard",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            },
            "description": "The page's content"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "The page's content",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "description": "The bundled OpenAPI document the backend validates every request against; `info.version` is the backend version.",
        "operationId": "getOpenAPI",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "document": {
                    "summary": "The document, cut after its first path",
                    "value": {
                      "info": {
                        "title": "Dash",
                        "version": "0.1.0"
                      },
                      "openapi": "3.1.0",
                      "paths": {
                        "/api/v1/version": {
                          "get": {
                            "operationId": "getVersion",
                            "summary": "The backend build",
                            "tags": [
                              "meta"
                            ]
                          }
                        }
                      },
                      "servers": [
                        {
                          "url": "/"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The OpenAPI document"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "This document",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/version": {
      "get": {
        "description": "The version, the commit and the build time the binary was built with; the UI's top bar shows the version.",
        "operationId": "getVersion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            },
            "description": "The build"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "The backend build",
        "tags": [
          "meta"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "What the backend is",
      "name": "meta"
    },
    {
      "description": "What the page shows",
      "name": "dashboard"
    }
  ]
}
