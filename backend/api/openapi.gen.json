{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "examples": {
              "notFound": {
                "summary": "No such route",
                "value": {
                  "code": "not_found",
                  "detail": "no route GET /api/v1/nothing",
                  "instance": "/api/v1/nothing",
                  "request_id": "019a2b3c-4d5e-7f60-8a9b-0c1d2e3f4a5b",
                  "status": 404,
                  "title": "Not found",
                  "type": "https://dash.gtrfc.com/problems/not-found"
                }
              },
              "validationFailed": {
                "summary": "A query parameter the document does not know; errors[] names it",
                "value": {
                  "code": "validation_failed",
                  "detail": "the request has parameters this route does not know",
                  "errors": [
                    {
                      "message": "unknown parameter",
                      "pointer": "query:verbose"
                    }
                  ],
                  "instance": "/api/v1/version",
                  "request_id": "019a2b3c-4d5e-7f60-8a9b-0c1d2e3f4a5c",
                  "status": 400,
                  "title": "Validation failed",
                  "type": "https://dash.gtrfc.com/problems/validation-failed"
                }
              }
            },
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "An RFC 9457 problem details body with a stable `code`, the `request_id` and, for a request the\ndocument refuses, `errors[]`.\n",
        "headers": {
          "X-Request-Id": {
            "description": "The request's id, also in the body and in the log line",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "schemas": {
      "App": {
        "description": "A tile",
        "properties": {
          "badges": {
            "description": "The pills on the icon, one per corner, in the order top-right, top-left, bottom-right, bottom-left",
            "items": {
              "$ref": "#/components/schemas/Badge"
            },
            "maxItems": 4,
            "type": "array"
          },
          "icon": {
            "$ref": "#/components/schemas/Icon"
          },
          "id": {
            "description": "Unique on the page: ingress/\u003cnamespace\u003e/\u003cname\u003e or app/\u003cgroup\u003e/\u003cindex\u003e",
            "type": "string"
          },
          "info": {
            "description": "The description; absent while ui.showAppInfo is off or the app has none",
            "type": "string"
          },
          "kind": {
            "description": "ingress: discovered; app: configured under apps",
            "enum": [
              "ingress",
              "app"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AppStatus"
          },
          "target_blank": {
            "type": "boolean"
          },
          "url": {
            "description": "An absolute http or https URL",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "url",
          "target_blank",
          "status",
          "icon",
          "badges"
        ],
        "type": "object"
      },
      "AppGroup": {
        "properties": {
          "apps": {
            "description": "Ordered by name",
            "items": {
              "$ref": "#/components/schemas/App"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "apps"
        ],
        "type": "object"
      },
      "AppStatus": {
        "description": "The readiness: endpoints ready over all, each pod once; unknown for a configured app and while ui.showAppStatus is off",
        "properties": {
          "ready": {
            "minimum": 0,
            "type": "integer"
          },
          "state": {
            "enum": [
              "healthy",
              "degraded",
              "down",
              "unknown"
            ],
            "type": "string"
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "state",
          "ready",
          "total"
        ],
        "type": "object"
      },
      "Badge": {
        "description": "A pill on an item's icon, in the style of macOS dock badges: a glyph or a text, filled with its\ntone. The label is the tooltip and the accessible name.\n",
        "properties": {
          "corner": {
            "enum": [
              "top-right",
              "top-left",
              "bottom-right",
              "bottom-left"
            ],
            "type": "string"
          },
          "icon": {
            "$ref": "#/components/schemas/Icon"
          },
          "label": {
            "type": "string"
          },
          "text": {
            "description": "The text of a text badge; absent for a glyph",
            "maxLength": 8,
            "type": "string"
          },
          "tone": {
            "enum": [
              "neutral",
              "blue",
              "cyan",
              "mint",
              "amber",
              "coral"
            ],
            "type": "string"
          }
        },
        "required": [
          "corner",
          "label",
          "tone"
        ],
        "type": "object"
      },
      "Bookmark": {
        "properties": {
          "badges": {
            "items": {
              "$ref": "#/components/schemas/Badge"
            },
            "maxItems": 4,
            "type": "array"
          },
          "icon": {
            "$ref": "#/components/schemas/Icon"
          },
          "id": {
            "description": "bookmark/\u003cgroup\u003e/\u003cindex\u003e",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "target_blank": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "target_blank",
          "icon",
          "badges"
        ],
        "type": "object"
      },
      "BookmarkGroup": {
        "properties": {
          "bookmarks": {
            "items": {
              "$ref": "#/components/schemas/Bookmark"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "bookmarks"
        ],
        "type": "object"
      },
      "Dashboard": {
        "description": "The page's content (backend/internal/dashboard)",
        "example": {
          "bookmarks": [
            {
              "bookmarks": [
                {
                  "badges": [],
                  "icon": {
                    "src": "/api/v1/icons/si@1.2.101/kubernetes.svg",
                    "tint": true
                  },
                  "id": "bookmark/0/0",
                  "name": "Kubernetes",
                  "target_blank": true,
                  "url": "https://kubernetes.io/docs"
                }
              ],
              "name": "docs"
            }
          ],
          "discovery": {
            "enabled": true,
            "instance_name": "",
            "namespaces": {
              "any": true,
              "label_selector": "",
              "names": []
            }
          },
          "groups": [
            {
              "apps": [
                {
                  "badges": [
                    {
                      "corner": "top-right",
                      "icon": {
                        "src": "/api/v1/icons/material-symbols@1.2.96/home.svg",
                        "tint": true
                      },
                      "label": "local network only",
                      "tone": "neutral"
                    }
                  ],
                  "icon": {
                    "src": "/api/v1/icons/sh@1d65d45a42e6/grafana.svg",
                    "tint": false
                  },
                  "id": "ingress/monitoring/grafana",
                  "kind": "ingress",
                  "name": "Grafana",
                  "status": {
                    "ready": 2,
                    "state": "healthy",
                    "total": 2
                  },
                  "target_blank": false,
                  "url": "https://grafana.example.com/"
                },
                {
                  "badges": [
                    {
                      "corner": "top-right",
                      "icon": {
                        "src": "/api/v1/icons/material-symbols@1.2.96/home.svg",
                        "tint": true
                      },
                      "label": "local network only",
                      "tone": "neutral"
                    },
                    {
                      "corner": "bottom-left",
                      "label": "beta release",
                      "text": "beta",
                      "tone": "amber"
                    }
                  ],
                  "icon": {
                    "src": "/api/v1/icons/sh@1d65d45a42e6/prometheus.svg",
                    "tint": false
                  },
                  "id": "ingress/monitoring/prometheus",
                  "kind": "ingress",
                  "name": "Prometheus",
                  "status": {
                    "ready": 1,
                    "state": "degraded",
                    "total": 2
                  },
                  "target_blank": false,
                  "url": "https://prometheus.example.com/"
                }
              ],
              "name": "monitoring"
            }
          ],
          "ui": {
            "default_theme": "system",
            "greeting": {
              "enabled": true,
              "environment": "production"
            },
            "light_strip": {
              "animation": "breathing",
              "color": "red"
            },
            "refresh_seconds": 60,
            "show_app_groups": true,
            "show_app_urls": true,
            "show_bookmark_groups": true,
            "title": "Dash"
          }
        },
        "properties": {
          "bookmarks": {
            "description": "The bookmark groups in the configuration's order. Empty while ui.showBookmarks is off",
            "items": {
              "$ref": "#/components/schemas/BookmarkGroup"
            },
            "type": "array"
          },
          "discovery": {
            "$ref": "#/components/schemas/DiscoveryScope"
          },
          "groups": {
            "description": "The app groups: those ui.groupOrder names first, in its order, then by name. Empty while ui.showApps is off",
            "items": {
              "$ref": "#/components/schemas/AppGroup"
            },
            "type": "array"
          },
          "ui": {
            "$ref": "#/components/schemas/DashboardUI"
          }
        },
        "required": [
          "ui",
          "discovery",
          "groups",
          "bookmarks"
        ],
        "type": "object"
      },
      "DashboardUI": {
        "description": "The ui settings the page applies itself",
        "properties": {
          "default_theme": {
            "description": "The colour scheme until a person picks one",
            "enum": [
              "system",
              "light",
              "dark"
            ],
            "type": "string"
          },
          "greeting": {
            "$ref": "#/components/schemas/Greeting"
          },
          "light_strip": {
            "$ref": "#/components/schemas/LightStrip"
          },
          "refresh_seconds": {
            "maximum": 3600,
            "minimum": 5,
            "type": "integer"
          },
          "show_app_groups": {
            "type": "boolean"
          },
          "show_app_urls": {
            "type": "boolean"
          },
          "show_bookmark_groups": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "greeting",
          "light_strip",
          "default_theme",
          "refresh_seconds",
          "show_app_groups",
          "show_app_urls",
          "show_bookmark_groups"
        ],
        "type": "object"
      },
      "DiscoveryScope": {
        "description": "What the discovery reads, for the page that has no app to show",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "instance_name": {
            "description": "discovery.instanceName; empty: every instance",
            "type": "string"
          },
          "namespaces": {
            "$ref": "#/components/schemas/NamespaceScope"
          }
        },
        "required": [
          "enabled",
          "instance_name",
          "namespaces"
        ],
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "message": {
            "type": "string"
          },
          "pointer": {
            "description": "A JSON pointer into the body, or query:\u003cname\u003e for a query parameter",
            "type": "string"
          }
        },
        "required": [
          "pointer",
          "message"
        ],
        "type": "object"
      },
      "Greeting": {
        "description": "The page's first line: the time of day and the environment, \"Good morning, welcome to production.\"",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "environment": {
            "description": "Empty: the greeting names none",
            "type": "string"
          }
        },
        "required": [
          "enabled",
          "environment"
        ],
        "type": "object"
      },
      "Icon": {
        "description": "A resolved icon: every app and bookmark has one, the fallbacks decided by the backend. A glyph\n(tint) is drawn as a mask in the page's colour; a logo as it is, src_dark in the dark scheme.\n",
        "properties": {
          "src": {
            "description": "The icon on the dashboard's origin, under /api/v1/icons/",
            "type": "string"
          },
          "src_dark": {
            "description": "The variant the dark scheme shows; absent when it is the same",
            "type": "string"
          },
          "tint": {
            "description": "A monochrome glyph, drawn in the colour of the page",
            "type": "boolean"
          }
        },
        "required": [
          "src",
          "tint"
        ],
        "type": "object"
      },
      "LightStrip": {
        "description": "The strip of frosted glass over the greeting, lit in a colour that tells the environment",
        "properties": {
          "animation": {
            "description": "How the light moves; it stands still where the browser asks for reduced motion",
            "enum": [
              "static",
              "breathing",
              "scanner",
              "flow"
            ],
            "type": "string"
          },
          "color": {
            "description": "Empty: the glass alone; a name, drawn in a shade of each colour scheme; or #rrggbb, drawn as given",
            "pattern": "^(|cyan|blue|magenta|red|orange|yellow|green|#[0-9a-fA-F]{6})$",
            "type": "string"
          }
        },
        "required": [
          "color",
          "animation"
        ],
        "type": "object"
      },
      "NamespaceScope": {
        "description": "The namespace selector: every namespace, or the names united with the label selector's matches",
        "properties": {
          "any": {
            "type": "boolean"
          },
          "label_selector": {
            "description": "The label selector in its text form, such as dash=listed; empty: none",
            "type": "string"
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "any",
          "names",
          "label_selector"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "An RFC 9457 problem details body (backend/internal/problem)",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "detail": {
            "description": "For a person; never a secret, a stack trace or an internal address",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "description": "The request path, without its query",
            "type": "string"
          },
          "request_id": {
            "description": "The id of the request, also in X-Request-Id and in the request log",
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "The code as a URI, https://dash.gtrfc.com/problems/\u003ccode\u003e; an identifier, not a link",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "ProblemCode": {
        "description": "The stable code of a problem",
        "enum": [
          "validation_failed",
          "not_found",
          "method_not_allowed",
          "internal",
          "not_ready"
        ],
        "type": "string"
      },
      "Version": {
        "example": {
          "build_time": "1793000000",
          "commit": "6c4adc7",
          "version": "0.1.0"
        },
        "properties": {
          "build_time": {
            "description": "When it was built, in seconds since the epoch",
            "type": "string"
          },
          "commit": {
            "description": "The commit the binary was built from",
            "type": "string"
          },
          "version": {
            "description": "The release, such as 0.1.0; dev for a build outside the release pipeline",
            "type": "string"
          }
        },
        "required": [
          "version",
          "commit",
          "build_time"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The API of Dash, a start page of the apps a Kubernetes cluster serves.\n\nThere is no login: whoever reaches the dashboard's host reaches this API, and protection is\nthe Ingress controller's (docs/security/exposure.md). The browser reaches it on the same\norigin as the UI: the Ingress `\u003cfullname\u003e-backend` routes `/api/` here. Errors are RFC 9457\nproblem details with a stable `code`.\n",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "title": "Dash",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/dashboard": {
      "get": {
        "description": "The app groups — discovered through Ingresses and configured — the bookmark groups and the\npage's settings. Answered from the discovery's cache: a request\ncosts the Kubernetes API server nothing. The page asks on load, every `ui.refreshSeconds` and\nwhen it becomes visible again. What the configuration hides (`ui.showApps`, `ui.showBookmarks`,\n`ui.showAppInfo`, `ui.showAppStatus`) is left out of the answer, not only out of the page.\n",
        "operationId": "getDashboard",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            },
            "description": "The page's content"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "The page's content",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/api/v1/icons/blob/{file}": {
      "get": {
        "description": "An icon from an icon ConfigMap or downloaded from a URL, as the backend checked it: a PNG it\nencoded again, or an SVG it found self-contained. Named by the SHA-256 of what is served, so\nimmutable; the addresses come from the dashboard's `icon.src`.\n",
        "operationId": "getBlobIcon",
        "parameters": [
          {
            "description": "\u003csha256\u003e.png or \u003csha256\u003e.svg",
            "in": "path",
            "name": "file",
            "required": true,
            "schema": {
              "pattern": "^[0-9a-f]{64}\\.(png|svg)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "image/svg+xml": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The icon",
            "headers": {
              "Cache-Control": {
                "description": "public, max-age=31536000, immutable",
                "schema": {
                  "type": "string"
                }
              },
              "Content-Security-Policy": {
                "description": "default-src 'none'; style-src 'unsafe-inline'; sandbox",
                "schema": {
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "description": "nosniff",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "An icon of a ConfigMap or a URL",
        "tags": [
          "icons"
        ]
      }
    },
    "/api/v1/icons/{pack}/{file}": {
      "get": {
        "description": "The SVG of an icon of a bundled catalogue (mdi, material-symbols, si, sh, di) at the version the\nbackend carries; the addresses come from the dashboard's `icon.src`. Immutable: another version\nis no icon. Served with a policy that runs nothing, so an SVG opened on its own cannot act on\nthe dashboard's origin.\n",
        "operationId": "getCatalogIcon",
        "parameters": [
          {
            "description": "\u003ccatalogue\u003e@\u003cversion\u003e, such as mdi@1.2.3",
            "in": "path",
            "name": "pack",
            "required": true,
            "schema": {
              "pattern": "^[a-z-]+@[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$",
              "type": "string"
            }
          },
          {
            "description": "\u003cname\u003e.svg",
            "in": "path",
            "name": "file",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*\\.svg$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/svg+xml": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The icon",
            "headers": {
              "Cache-Control": {
                "description": "public, max-age=31536000, immutable",
                "schema": {
                  "type": "string"
                }
              },
              "Content-Security-Policy": {
                "description": "default-src 'none'; style-src 'unsafe-inline'; sandbox",
                "schema": {
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "description": "nosniff",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "An icon of a bundled catalogue",
        "tags": [
          "icons"
        ]
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "description": "The bundled OpenAPI document the backend validates every request against; `info.version` is the backend version.",
        "operationId": "getOpenAPI",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "document": {
                    "summary": "The document, cut after its first path",
                    "value": {
                      "info": {
                        "title": "Dash",
                        "version": "0.1.0"
                      },
                      "openapi": "3.1.0",
                      "paths": {
                        "/api/v1/version": {
                          "get": {
                            "operationId": "getVersion",
                            "summary": "The backend build",
                            "tags": [
                              "meta"
                            ]
                          }
                        }
                      },
                      "servers": [
                        {
                          "url": "/"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "The OpenAPI document"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "This document",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/version": {
      "get": {
        "description": "The version, the commit and the build time the binary was built with; the UI's top bar shows the version.",
        "operationId": "getVersion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            },
            "description": "The build"
          },
          "default": {
