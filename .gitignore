dist/

# The end-to-end suite's results
frontend/e2e/test-results/
frontend/e2e/playwright-report/

# Go workspace files: each module stands alone
go.work
go.work.sum

# OS and editors
.DS_Store
.idea/
.vscode/
*.swp
