{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":automergeDigest"
  ],
  "schedule": [
    "at any time"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "ignoreTests": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "rebaseWhen": "conflicted",
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "description": "TypeScript: stay inside the peer range of Angular; update this string with every Angular major",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": ">=6.0 <6.1"
    },
    {
      "description": "npm (packageManager field): automerge minor and patch, a major waits",
      "matchManagers": ["npm"],
      "matchDepTypes": ["packageManager"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Go version: one group across both go.mod files, both Containerfiles, the workflows and the release template",
      "matchDatasources": ["golang-version"],
      "groupName": "Go version",
      "groupSlug": "go-version"
    },
    {
      "description": "golang.org/x modules move with the Go version, so govulncheck sees a consistent set",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^golang\\.org\\/x\\//"],
      "groupName": "Go version",
      "groupSlug": "go-version"
    },
    {
      "description": "Go version: patches at once, they are the security channel",
      "matchDatasources": ["golang-version"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Go version: minors after a release age of seven days",
      "matchDatasources": ["golang-version"],
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "The golang build image is moved by the Go version manager below, not by the dockerfile manager",
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["golang"],
      "enabled": false
    },
    {
      "description": "Go modules: indirect dependencies too, so transitive security fixes land without waiting for a direct require",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Go modules: automerge minor and patch after CI passes",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require", "indirect"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Go modules: a major of a direct require waits for a person",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Go modules: no major pull requests for indirect dependencies; they move with their direct parent",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Angular: one pull request per release train for the framework, the CLI, the build system and angular-eslint",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json"],
      "matchPackageNames": ["/^@angular\\//", "/^@angular-eslint\\//", "angular-eslint"],
      "groupName": "Angular",
      "groupSlug": "angular"
    },
    {
      "description": "Frontend npm: automerge minor and patch after CI passes",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Frontend npm: a major waits for a person (Angular majors carry migrations)",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/package.json"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Release tooling (root package.json): automerge minor and patch; the release-tooling job proves the set still renders notes",
      "matchManagers": ["npm"],
      "matchFileNames": ["package.json"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Release notes preset: conventional-changelog-conventionalcommits 10 needs conventional-changelog-writer 9, which release-notes-generator 14 does not bring; hold it below 10 until the generator moves",
      "matchDepNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "<10"
    },
    {
      "description": "Base images (node build stage, distroless runtime): automerge minor, patch and digest",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Base images: a major waits for a person",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "kind and its node image move together",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["sigs.k8s.io/kind", "kindest/node"],
      "groupName": "kind",
      "groupSlug": "kind"
    },
    {
      "description": "GitHub Actions: automerge minor and patch",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "GitHub Actions: automerge majors after CI passes",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    },
    {
      "description": "Makefile pins (custom regex manager): automerge minor and patch at once, the Go tools ahead of the Go version they must understand",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Makefile pins: a major waits for a person",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Use fix instead of chore for dependency updates, so a release ships them",
      "semanticCommitType": "fix",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"]
    },
    {
      "description": "GitHub Actions: chore, they ship nothing",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "chore"
    }
  ],
  "customManagers": [
    {
      "description": "Tool versions pinned in the Makefile through renovate comments (go, docker, helm datasources)",
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: registryUrl=(?<registryUrl>[^\\s]+))?\\n[A-Z_]+\\s*\\?=\\s*(?:[^\\s:@]+:)?(?<currentValue>[^\\s:@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\\n"
      ],
      "versioningTemplate": "{{#if (equals datasource 'docker')}}docker{{else}}semver{{/if}}"
    },
    {
      "description": "Go version of the golang build stage in both Containerfiles",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Containerfile$/"],
      "matchStrings": [
        "FROM\\s+(?:--platform=\\S+\\s+)?golang:(?<currentValue>[\\d.]+)-alpine"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Go version in both go.mod files",
      "customType": "regex",
      "managerFilePatterns": ["/^backend/go\\.mod$/", "/^frontend/server/go\\.mod$/"],
      "matchStrings": [
        "\\ngo\\s+(?<currentValue>[\\d.]+)\\n"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Go version in the GitHub workflows",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "GO_VERSION:\\s+['\"]?(?<currentValue>[\\d.]+)['\"]?"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "description": "Go version in the release template badge (major.minor only)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/release-template\\.hbs$/"],
      "matchStrings": [
        "go-(?<currentValue>\\d+\\.\\d+)-blue"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)"
    },
    {
      "description": "The Node.js major of the frontend and end-to-end jobs",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "NODE_VERSION:\\s+['\"]?(?<currentValue>\\d+)['\"]?"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "gomod": {
    "enabled": true,
    "postUpdateOptions": [
      "gomodTidy",
      "gomodUpdateImportPaths"
    ]
  }
}
